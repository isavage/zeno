# ==============================================================================
# Zeno Personal Assistant Configuration
# ==============================================================================
# In production on VPS: All secrets are injected dynamically via Doppler.
# In local development: Copy this file to .env and fill in the values.

# Server & Environment
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=generate_a_random_32_byte_secret_for_sessions_and_cookies
VAULT_DATA_DIR=./data/vault

# Encryption Master Key (32 bytes hex or url-safe base64 for AES-256-GCM / Fernet)
# You can generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENOS_ENCRYPTION_KEY=

# LLM Providers (Fill at least one paid provider and/or OpenRouter / Nous)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# Intelligent Model Selection Preferences
DEFAULT_FAST_MODEL=nousresearch/hermes-3-llama-3.1-8b
DEFAULT_REASONING_MODEL=deepseek-chat
DEFAULT_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
ENABLE_TELEGRAM_VOICE_REPLIES=true

# Web UI OAuth (Google or Microsoft)
AUTH_PROVIDER=google
# Authorized Emails Whitelist (comma separated)
AUTHORIZED_EMAILS=myemail@gmail.com,admin@example.com

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Relative path used to build the public redirect URI from the current host
GOOGLE_REDIRECT_PATH=/auth/google/callback

# Microsoft OAuth Credentials (if AUTH_PROVIDER=microsoft)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_PATH=/auth/microsoft/callback

# Voice Configuration
WHISPER_MODEL_SIZE=base.en
KOKORO_VOICE=af_heart
